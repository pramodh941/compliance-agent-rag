# Cloud-Production Deployment Profile
# Full production deployment with all features enabled
# Optimized for performance and reliability

# SECURITY REQUIREMENTS:
# All values marked with ${VAR_NAME} MUST be explicitly set as environment variables
# before deployment. They are NOT provided by default for security reasons.
# Required environment variables:
# - CLOUD_SQL_HOST: Cloud database host
# - CLOUD_SQL_USER: Strong database username (NOT 'admin')
# - CLOUD_SQL_PASSWORD: Strong database password
# - QDRANT_CLOUD_URL: Qdrant vector database URL
# - OLLAMA_CLOUD_URL: Ollama API endpoint URL
# - RERANKER_CLOUD_URL: Reranker service URL

# =========================
# DEPLOYMENT PROFILE
# =========================
DEPLOYMENT_PROFILE=cloud-production

# =========================
# DATABASE CONFIGURATION
# =========================
# Use managed database services in production
# These variables MUST be set via environment - never commit credentials
POSTGRES_HOST=${CLOUD_SQL_HOST}
POSTGRES_PORT=5432
POSTGRES_USER=${CLOUD_SQL_USER}
POSTGRES_PASSWORD=${CLOUD_SQL_PASSWORD}
POSTGRES_DB=compliance

# =========================
# SERVICE URLS
# =========================
# These variables MUST be set via environment for production
QDRANT_URL=${QDRANT_CLOUD_URL}
OLLAMA_BASE_URL=${OLLAMA_CLOUD_URL}
MCP_BASE_URL=http://mcp-server:8001
AGENT_WORKER_URL=http://agent-worker:8002
RERANKER_URL=${RERANKER_CLOUD_URL}

# =========================
# MODEL CONFIGURATION
# =========================
# Production-grade models for best quality
LLM_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Override with cloud API models for production:
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# RERANKER_MODEL=openai-reranker

# =========================
# FEATURE TOGGLES
# =========================
# All features enabled for production
ENABLE_RERANKING=true
ENABLE_OCR=true
ENABLE_LAYOUT_PARSING=true
ENABLE_TABLE_EXTRACTION=true
ENABLE_IMAGE_EXTRACTION=true
ENABLE_SEMANTIC_CHUNKING=true
ENABLE_HIERARCHY_DETECTION=true
ENABLE_METADATA_EXTRACTION=true

# =========================
# INGESTION CONFIGURATION
# =========================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
PDF_PARSER=pdfplumber
CHUNKING_STRATEGY=semantic

# =========================
# COLLECTION NAMES
# =========================
POLICIES_COLLECTION=policies
SEC_DOCS_COLLECTION=sec_docs

# =========================
# TIMEOUTS
# =========================
# Production-optimized timeouts
API_REQUEST_TIMEOUT=300
AGENT_RUN_TIMEOUT=600
PLANNER_TIMEOUT=300
MCP_TIMEOUT=300

# =========================
# RAG RETRIEVAL PARAMETERS
# =========================
# Higher limits for production
DENSE_RETRIEVAL_LIMIT=10
SPARSE_RETRIEVAL_K=10
RERANK_TOP_K=5
MAX_CONTEXT_LENGTH=400
MAX_EMBEDDING_CHARS=4000

# =========================
# PERFORMANCE
# =========================
# Production-optimized batch sizes
EMBEDDING_BATCH_SIZE=20
MAX_CONCURRENT_DOCS=8
DOC_PROCESSING_TIMEOUT=300

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO

# =========================
# OCR CONFIGURATION
# =========================
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_TIMEOUT=30

# =========================
# CLOUD API KEYS (if using cloud models)
# =========================
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# =========================
# SECURITY
# =========================
# Set secure credentials in production
# POSTGRES_USER and POSTGRES_PASSWORD should be set via secrets
