POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=your_secure_username_here
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=compliance
POSTGRES_URL=postgresql://your_secure_username_here:your_secure_password_here@postgres:5432/compliance

QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
MCP_BASE_URL=http://mcp-server:8001
API_BASE_URL=http://api:8000
AGENT_WORKER_URL=http://agent-worker:8002
AGENT_PUBLIC_URL=http://localhost:8002

EMBEDDING_MODEL=nomic-embed-text
PLANNER_MODEL=gemma:2b

API_REQUEST_TIMEOUT=180
AGENT_RUN_TIMEOUT=300
MCP_TIMEOUT=180
PLANNER_TIMEOUT=180
LOG_LEVEL=INFO
