# Local-Lite Deployment Profile
# Minimal resources, CPU-only, ~4GB RAM
# Uses lightweight models and disables optional features

# =========================
# DEPLOYMENT PROFILE
# =========================
DEPLOYMENT_PROFILE=local-lite

# =========================
# DATABASE CONFIGURATION
# =========================
# NOTE: These are convenience defaults for LOCAL DEVELOPMENT ONLY
# For production, always use strong, unique credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=compliance

# =========================
# SERVICE URLS
# =========================
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
MCP_BASE_URL=http://mcp-server:8001
AGENT_WORKER_URL=http://agent-worker:8002
RERANKER_URL=http://reranker:7997

# =========================
# MODEL CONFIGURATION
# =========================
# Lightweight models for CPU-only systems
LLM_MODEL=gemma:2b
EMBEDDING_MODEL=nomic-embed-text
# Reranker disabled in local-lite profile

# =========================
# FEATURE TOGGLES
# =========================
# All optional features disabled for minimal resource usage
ENABLE_RERANKING=false
ENABLE_OCR=false
ENABLE_LAYOUT_PARSING=false
ENABLE_TABLE_EXTRACTION=false
ENABLE_IMAGE_EXTRACTION=false
ENABLE_SEMANTIC_CHUNKING=false
ENABLE_HIERARCHY_DETECTION=true
ENABLE_METADATA_EXTRACTION=true

# =========================
# INGESTION CONFIGURATION
# =========================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
PDF_PARSER=pypdf
CHUNKING_STRATEGY=simple

# =========================
# COLLECTION NAMES
# =========================
POLICIES_COLLECTION=policies
SEC_DOCS_COLLECTION=sec_docs

# =========================
# TIMEOUTS
# =========================
API_REQUEST_TIMEOUT=180
AGENT_RUN_TIMEOUT=300
PLANNER_TIMEOUT=180
MCP_TIMEOUT=180

# =========================
# RAG RETRIEVAL PARAMETERS
# =========================
DENSE_RETRIEVAL_LIMIT=5
SPARSE_RETRIEVAL_K=5
RERANK_TOP_K=2
MAX_CONTEXT_LENGTH=400
MAX_EMBEDDING_CHARS=4000

# =========================
# PERFORMANCE
# =========================
EMBEDDING_BATCH_SIZE=5
MAX_CONCURRENT_DOCS=2
DOC_PROCESSING_TIMEOUT=300

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO
