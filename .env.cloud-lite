# Cloud-Lite Deployment Profile
# Minimal cloud deployment for cost-optimized scenarios
# Similar to local-lite but with cloud-optimized settings

# SECURITY REQUIREMENTS:
# All values marked with ${VAR_NAME} MUST be explicitly set as environment variables
# before deployment. They are NOT provided by default for security reasons.
# Required environment variables:
# - CLOUD_SQL_HOST: Cloud database host
# - CLOUD_SQL_USER: Strong database username (NOT 'admin')
# - CLOUD_SQL_PASSWORD: Strong database password
# - QDRANT_CLOUD_URL: Qdrant vector database URL
# - OLLAMA_CLOUD_URL: Ollama API endpoint URL

# =========================
# DEPLOYMENT PROFILE
# =========================
DEPLOYMENT_PROFILE=cloud-lite

# =========================
# DATABASE CONFIGURATION
# =========================
# Use managed database services in production
# These variables MUST be set via environment - never commit credentials
POSTGRES_HOST=${CLOUD_SQL_HOST}
POSTGRES_PORT=5432
POSTGRES_USER=${CLOUD_SQL_USER}
POSTGRES_PASSWORD=${CLOUD_SQL_PASSWORD}
POSTGRES_DB=compliance

# =========================
# SERVICE URLS
# =========================
# These variables MUST be set via environment for production
QDRANT_URL=${QDRANT_CLOUD_URL}
OLLAMA_BASE_URL=${OLLAMA_CLOUD_URL}
MCP_BASE_URL=http://mcp-server:8001
AGENT_WORKER_URL=http://agent-worker:8002
# Reranker disabled in cloud-lite profile

# =========================
# MODEL CONFIGURATION
# =========================
# Lightweight models for cost efficiency
LLM_MODEL=gemma:2b
EMBEDDING_MODEL=nomic-embed-text
# Can override with cloud API models:
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# =========================
# FEATURE TOGGLES
# =========================
# Minimal features for cost optimization
ENABLE_RERANKING=false
ENABLE_OCR=false
ENABLE_LAYOUT_PARSING=false
ENABLE_TABLE_EXTRACTION=false
ENABLE_IMAGE_EXTRACTION=false
ENABLE_SEMANTIC_CHUNKING=false
ENABLE_HIERARCHY_DETECTION=true
ENABLE_METADATA_EXTRACTION=true

# =========================
# INGESTION CONFIGURATION
# =========================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
PDF_PARSER=pypdf
CHUNKING_STRATEGY=simple

# =========================
# COLLECTION NAMES
# =========================
POLICIES_COLLECTION=policies
SEC_DOCS_COLLECTION=sec_docs

# =========================
# TIMEOUTS
# =========================
# Cloud-optimized timeouts
API_REQUEST_TIMEOUT=180
AGENT_RUN_TIMEOUT=300
PLANNER_TIMEOUT=180
MCP_TIMEOUT=180

# =========================
# RAG RETRIEVAL PARAMETERS
# =========================
DENSE_RETRIEVAL_LIMIT=5
SPARSE_RETRIEVAL_K=5
RERANK_TOP_K=2
MAX_CONTEXT_LENGTH=400
MAX_EMBEDDING_CHARS=4000

# =========================
# PERFORMANCE
# =========================
# Cloud-optimized batch sizes
EMBEDDING_BATCH_SIZE=10
MAX_CONCURRENT_DOCS=4
DOC_PROCESSING_TIMEOUT=300

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO

# =========================
# CLOUD API KEYS (if using cloud models)
# =========================
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
