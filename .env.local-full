# Local-Full Deployment Profile
# Full local development with optional GPU support
# Enables all features including reranker, OCR, and advanced parsing

# =========================
# DEPLOYMENT PROFILE
# =========================
DEPLOYMENT_PROFILE=local-full

# =========================
# DATABASE CONFIGURATION
# =========================
# NOTE: These are convenience defaults for LOCAL DEVELOPMENT ONLY
# For production, always use strong, unique credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=compliance

# =========================
# SERVICE URLS
# =========================
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
MCP_BASE_URL=http://mcp-server:8001
AGENT_WORKER_URL=http://agent-worker:8002
RERANKER_URL=http://reranker:7997

# =========================
# MODEL CONFIGURATION
# =========================
# Larger models for better quality (requires more RAM)
LLM_MODEL=gemma:2b
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =========================
# FEATURE TOGGLES
# =========================
# All features enabled for full functionality
ENABLE_RERANKING=true
ENABLE_OCR=true
ENABLE_LAYOUT_PARSING=true
ENABLE_TABLE_EXTRACTION=true
ENABLE_IMAGE_EXTRACTION=true
ENABLE_SEMANTIC_CHUNKING=true
ENABLE_HIERARCHY_DETECTION=true
ENABLE_METADATA_EXTRACTION=true

# =========================
# INGESTION CONFIGURATION
# =========================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
PDF_PARSER=pdfplumber
CHUNKING_STRATEGY=semantic

# =========================
# COLLECTION NAMES
# =========================
POLICIES_COLLECTION=policies
SEC_DOCS_COLLECTION=sec_docs

# =========================
# TIMEOUTS
# =========================
API_REQUEST_TIMEOUT=180
AGENT_RUN_TIMEOUT=300
PLANNER_TIMEOUT=180
MCP_TIMEOUT=180

# =========================
# RAG RETRIEVAL PARAMETERS
# =========================
DENSE_RETRIEVAL_LIMIT=5
SPARSE_RETRIEVAL_K=5
RERANK_TOP_K=2
MAX_CONTEXT_LENGTH=400
MAX_EMBEDDING_CHARS=4000

# =========================
# PERFORMANCE
# =========================
EMBEDDING_BATCH_SIZE=10
MAX_CONCURRENT_DOCS=4
DOC_PROCESSING_TIMEOUT=300

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO

# =========================
# OCR CONFIGURATION
# =========================
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_TIMEOUT=30
